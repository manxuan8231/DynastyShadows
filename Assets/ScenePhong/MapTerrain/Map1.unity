  - "L\xEDnh Canh B"
  - "L\xEDnh Canh B"
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh B"
  - "L\xEDnh Canh B"
  - "H\xE0 Nh\xE2n"
  content:
  - "Anh l\xE0 ng\u01B0\u1EDDi \u0111\xE3 \u0111i do th\xE1m b\xEAn khu \u0111\u1EA7m
    l\u1EA7y \u0111\xF3 \u01B0? "
  - "V\xE2ng, l\xE0 t\xF4i "
  - "Anh c\u1EA7n th\xF4ng tin v\u1EC1 n\xF3 \xE0 "
  - "\u0110\xFAng r\u1ED3i "
  - "T\xF4i c\u1EA7n th\xF4ng tin v\u1EC1 n\u01A1i anh g\u1EB7p sinh v\u1EADt \u0111\xF3
    v\xE0 \u0111\u01B0\u1EDDng \u0111i. "
  - "Anh l\xE0 ng\u01B0\u1EDDi \u0111\u01B0\u1EE3c b\xE1c L\xE2m \u0111\u1EC1 c\u1EED
    \u0111i l\xE0m nhi\u1EC7m v\u1EE5 n\xE0y \u01B0? "
  - "Anh c\xF3 ch\u1EAFc l\xE0 m\xECnh s\u1EBD \u1ED5n khi nh\u1EADn nhi\u1EC7m v\u1EE5
    n\xE0y kh\xF4ng"
  - "T\xF4i ch\u1EAFc ch\u1EAFn v\u1EC1 vi\u1EC7c m\xECnh s\u1EBD \u0111i th\u1EF1c
    hi\u1EC7n nhi\u1EC7m v\u1EE5 n\xE0y. "
  - " Nh\u01B0ng t\xF4i c\u1EA7n anh cung c\u1EA5p cho t\xF4i th\xF4ng tin. "
  - 'uhm... '
  - "\u0110\u01B0\u1EE3c r\u1ED3i "
  - "T\xF4i s\u1EBD cho anh bi\u1EBFt l\u01B0\u1EE3ng th\xF4ng tin t\xF4i c\xF3 "
  - " V\u1EC1 v\u1ECB tr\xED th\xEC n\xF3 l\xE0 khu \u0111\u1EA7m l\u1EA7y \u1EDF
    \u0111\u01B0\u1EDDng th\u1EB3ng ngay ng\xE3 ba \u0111i v\xE0o trong r\u1EEBng "
  - "Anh \u0111i s\xE2u v\xE0o \u0111\xF3 s\u1EBD \u0111\u1EBFn khu \u0111\u1EA7m
    l\u1EA7y"
  - "V\u1EC1 h\xECnh d\xE1ng sinh v\u1EADt \u0111\xF3 th\xEC trong n\xF3 c\xF3 h\xECnh
    d\u1EA1ng nh\u01B0 m\u1ED9t con ng\u01B0\u1EDDi b\u1ECB "
  - "Nh\u01B0ng nh\xECn k\u1EF9 th\xEC l\u1EA1i gi\u1ED1ng m\u1ED9t c\xE1i c\xE2y "
  - "m\u1ED9t t\u01B0\u1EE3ng g\u1ED7 ? "
  - "T\u01B0\u1EE3ng g\u1ED7? "
  - "Ng\u01B0\u1EDDi c\xE2y \u01B0"
  - "Ch\u1EAFc l\xE0 v\u1EADy "
  - "t\xF4i ch\u1EC9 th\u1EA5y c\xF3 th\u1EBF ch\u1EE9 kh\xF4ng d\xE1m \u0111\u1EBFn
    g\u1EA7n. "
  - "L\u01B0\u1EE3ng th\xF4ng tin kh\xF4ng nhi\u1EC1u nh\u1EC9? "
  - "Nh\u01B0ng t\xF4i ngh\u0129 c\xF3 v\u1EBB n\xF3 trong kh\xF4ng kh\xF3 nh\u1EB1n
    g\xEC "
  - "Anh c\xF3 v\u1EBB l\u1EA1c quan qu\xE1 nh\u1EC9 "
  - "khi l\xE0m nhi\u1EC7m v\u1EE5 th\u1EBF n\xE0y \u0111\u1EEBng n\xEAn m\u1EA5t
    c\u1EA3nh gi\xE1c "
  - "trong anh c\u1EE9 nh\u01B0 ng\u01B0\u1EDDi m\u1EDBi"
  - ...
  - "Kh\xF4ng \u0111\xF9a v\u1EDBi anh n\u1EEFa "
  - "Ch\xFAc anh may m\u1EAFn."
  - "\u1EEA t\xF4i bi\u1EBFt r\u1ED3i. "
