  icon3D: {fileID: 651667293}
  niceQuestUI: {fileID: 1523850179}
  arrowIcon: {fileID: 620713925}
  questBoss: {fileID: 1308173397}
  names:
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "H\xE0 Nh\xE2n"
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "H\xE0 Nh\xE2n"
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "G\xE1c c\u1ED5ng B"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "G\xE1c c\u1ED5ng B"
  content:
  - "Anh v\u1EC1 r\u1ED3i \xE0 ?"
  - "C\xF3 v\u1EBB m\u1ECDi chuy\u1EC7n thu\u1EADn l\u1EE3i, trong anh quay v\u1EC1
    l\xE0nh l\u1EA1nh th\u1EBF n\xE0y m\xE0. "
  - "Trong anh c\xF3 v\u1EBB nh\xE0n, sao kh\xF4ng th\u1EED \u0111i d\u1ECDn d\u1EB9p
    b\u1ECDn kia th\u1EED nh\u1EC9?"
  - " \u1EDCm... \u0111\xF9a th\xF4i, ch\u1EC9 l\xE0 \u0111\xF9a th\xF4i. "
  - "Ti\u1EBFp theo anh \u0111\u1ECBnh l\xE0m g\xEC? "
  - "T\xF4i ngh\u0129 m\xECnh s\u1EBD \u0111\u1EBFn v\u01B0\u01A1ng qu\u1ED1c \u0111\u1EC3
    b\xE1o c\xE1o m\u1ED9t s\u1ED1 chuy\u1EC7n di\u1EC5n ra \u1EDF \u0111\xE2y."
  - "C\xF3 v\u1EBB l\xE0 ph\u1EA3i \u0111i xa r\u1ED3i. "
  - "T\xF4i ngh\u0129 c\u0169ng n\xEAn b\xE1o c\xE1o l\xEAn tr\xEAn."
  - " M\xECnh anh \u0111i th\xF4i \xE0? "
  - "\u1EEA, chuy\u1EC7n n\xE0y t\xF4i gi\u1EA3i quy\u1EBFt \u0111\u01B0\u1EE3c. "
  - "T\xF4i ngh\u0129 \u1EDF \u0111\xE2y c\u1EA7n ng\u01B0\u1EDDi b\u1EA3o v\u1EC7. "
  - "Anh n\xF3i ph\u1EA3i."
  - "T\u1EEB l\xFAc \u0111\u1EBFn \u0111\xE2y c\u0169ng kh\xE1 nhi\u1EC1u chuy\u1EC7n
    x\u1EA3y ra n\xEAn qu\xE2n s\u1ED1 c\xF3 ch\xFAt thay \u0111\u1ED5i"
  - "Do kh\xE1 xa v\u01B0\u01A1ng qu\u1ED1c n\xEAn kh\xF4ng th\u1EC3 b\xE1o l\xEAn
    tr\xEAn \u0111\u01B0\u1EE3c. "
  - "\u0110\u1EBFn th\u1ECB tr\u1EA5n truy\u1EC1n tin th\xEC c\xF3 c\xE1c qu\xE1i
    v\u1EADt \u1EDF ngo\xE0i n\xEAn kh\xF4ng th\u1EC3 ra. "
  - "Chuy\u1EC7n n\xE0y m\u1ED9t m\xECnh t\xF4i \u0111i ch\u1EAFc ch\u1EAFn \u1ED5n "
  - "Anh y\xEAn t\xE2m "
  - "H\xF4m nay t\xF4i s\u1EBD kh\u1ECFi h\xE0nh. "
