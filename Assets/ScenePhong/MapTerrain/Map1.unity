--- !u!114 &829134889717397204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 56995824865684586}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 822f1537b625c494e849feaaa7bf3bec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  NPCPanel: {fileID: 1391429572}
  NPCName: {fileID: 924347526}
  NPCContent: {fileID: 638759859}
  buttonF: {fileID: 1068874698}
  buttonSkip: {fileID: 1141845012}
  player: {fileID: 0}
  cam: {fileID: 2048055361}
  audioSource: {fileID: 0}
  audioSkip: {fileID: 8300000, guid: d8f42014edbccc0439ea92b410ad4557, type: 3}
  questToStart: 3
  names:
  - "L\xEDnh Canh"
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh"
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh"
  - "L\xEDnh Canh"
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh"
  content:
  - "Ch\xE0o H\xE0 Nh\xE2n, nay l\u1EA1i \u0111\u1EBFn mu\u1ED9n nh\u1EC9? "
  - "V\xE2ng, do trong l\xE0ng c\xF3 v\xE0i chuy\u1EC7n x\u1EA3y ra, c\xF3 v\u1EBB
    nh\u01B0 b\u1ECDn sinh v\u1EADt ngo\xE0i l\xE0ng \u0111ang c\xF3 chuy\u1EC3n
    bi\u1EBFn. "
  - "C\xF3 \u0111i\u1EC1u g\xEC b\u1EA5t \u1ED5n \xE0? "
  - " \u1EEA, h\xECnh nh\u01B0 b\u1ECDn ch\xFAng \u0111ang c\xF3 \xFD \u0111\u1ECBnh
    chi\u1EBFm l\xE0ng"
  - "C\xF3 th\xF4ng tin b\xEAn Ng\u01B0 D\xE2n l\xE0 b\u1ECDn ch\xFAng c\xF3 v\u1EBB
    \u0111\xE3 x\xE2y h\u1EB3n m\u1ED9t tr\u1EA1i l\u1EDBn b\xEAn kia b\u1EDD s\xF4ng. "
  - "Chuy\u1EC7n n\xE0y th\u1EADt s\u1EF1 nghi\xEAm tr\u1ECDng r\u1ED3i. T\xF4i ngh\u0129
    ch\xFAng ta c\u1EA7n ph\u1EA3i h\xE0nh \u0111\u1ED9ng tr\u01B0\u1EDBc b\u1ECDn
    ch\xFAng m\u1ED9t b\u01B0\u1EDBc. "
  - " T\xF4i ngh\u0129 t\xF4i s\u1EBD qua b\xEAn \u0111\xF3 \u0111\u1EC3 d\u1ECDn
    d\u1EB9p ch\xFAng, ng\u0103n ch\u1EB7n vi\u1EC7c b\u1ECDn ch\xFAng x\xE2m nh\u1EADp
    v\xE0o l\xE0ng. "
  - " Anh \u0111i \xE0?"
  - " Anh \u0111i \xE0? - M\xECnh anh \u01B0? "
  - " \u1EEA, anh kh\xF4ng c\u1EA7n lo, t\u1EEB nh\u1ECF t\xF4i \u0111\xE3 c\xF3
    th\u1EC3 ch\u1EA5t h\u01A1n ng\u01B0\u1EDDi th\u01B0\u1EDDng n\xEAn vi\u1EC7c
    n\xE0y t\xF4i n\xEAn l\xE0 ng\u01B0\u1EDDi ti\xEAn phong. "
  - "Th\u1EADt s\u1EF1 \u1ED5n ch\u1EE9, t\xF4i v\u1EABn c\u1EA3m th\u1EA5y ta n\xEAn
    b\xE1o cho c\xE1c k\u1EF5 s\u0129 kh\xE1c t\u1EADp h\u1EE3p l\u1EA1i c\xF9ng
    \u0111i th\xEC h\u01A1n. "
  - "Kh\xF4ng c\u1EA7n ph\u1EA3i l\xE0m th\u1EBF \u0111\xE2u, tr\u1EA1i b\u1ECDn
    ch\xFAng d\u1EF1ng l\xEAn ch\u1EAFc c\u0169ng m\u1EDBi \u0111\xE2y th\xF4i n\xEAn
    m\u1EDBi qua b\xEAn l\xE0ng \u0111\u1EC3 l\u1EA5y th\xEAm v\u1EADt li\u1EC7u.  "
  - "V\u1EDBi l\u1EA1i c\xE1c k\u1EF5 s\u0129 kh\xE1c c\u0169ng \u0111ang l\xE0m
    nhi\u1EC7m v\u1EE5 kh\xE1 xa c\xF3 th\u1EC3 s\u1EBD kh\xE1c m\u1EA5t th\u1EDDi
    gian \u0111\u1EC3 h\u1ECD tr\u1EDF v\u1EC1.  "
  - "Tin t\xF4i, t\xF4i s\u1EBD an to\xE0n tr\u1EDF v\u1EC1. "
  - "\u0110\u01B0\u1EE3c r\u1ED3i, h\xE3y tr\u1EDF v\u1EC1 an to\xE0n. "
