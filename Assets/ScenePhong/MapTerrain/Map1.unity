  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92ef7adb1d402324494e0a494c845d9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  NPCPanel: {fileID: 264900068}
  NPCName: {fileID: 1094173007}
