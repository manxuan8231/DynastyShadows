  audioSkip: {fileID: 8300000, guid: deff2fb538f3b7a44aa556210c060408, type: 3}
  questToStart: 5
  names:
  - "H\xE0 Nh\xE2n"
  - "L\xEDnh Canh B"
  - "L\xEDnh Canh B"
  - "H\xE0 Nh\xE2n"
  - "H\xE0 Nh\xE2n"
