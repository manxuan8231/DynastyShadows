      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'names.Array.data[3]'
      value: "H\xE0 Nh\xE2n"
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'names.Array.data[4]'
      value: "D\xE2n l\xE0ng"
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'names.Array.data[5]'
      value: "H\xE0 nh\xE2n"
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'names.Array.data[6]'
      value: "D\xE2n l\xE0ng"
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[0]'
      value: "N\xE0y H\xE0 Nh\xE2n, t\xF4i c\xF3 tin n\xE0y v\xE0 t\xF4i ngh\u0129
        l\xE0 t\xF4i c\u1EA7n c\u1EADu gi\xFAp!"
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[1]'
      value: "Sao \u0111\u1EA5y anh, c\xF3 chuy\u1EC7n g\xEC quan tr\u1ECDng c\u1EA7n
        t\xF4i gi\xFAp \xE0? "
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[2]'
      value: "\u1EEA, t\xF4i v\u1EEBa nh\u1EADn \u0111\u01B0\u1EE3c tin b\xE1o t\u1EEB
        b\xEAn khu \u0111\xE1nh c\xE1, b\xEAn \u0111\xF3 b\u1EA3o c\u1EA7n ng\u01B0\u1EDDi
        gi\xFAp x\u1EED l\xED vi\u1EC7c b\u1ECDn y\xEAu tinh c\u1EE9 qu\u1EADy ph\xE1
        b\xEAn \u0111\xF3. "
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[3]'
      value: "B\u1ECDn y\xEAu tinh \u01B0?!"
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[4]'
      value: "B\u1ECDn ch\xFAng sao l\u1EA1i t\u1EDBi b\xEAn s\xF4ng ph\xE1 th\u1EBF
        kia, t\xF4i nh\u1EDB l\xE0 b\u1ECDn ch\xFAng kh\xF4ng th\u1EC3 qua \u0111\u01B0\u1EE3c
        con s\xF4ng \u0111\xF3 m\xE0."
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[5]'
      value: "T\xF4i c\u0169ng v\u1EADy, nh\u01B0ng t\xF4i ngh\u0129 ch\u1EAFc c\xF3
        bi\u1EBFn \u0111\u1ED9ng n\xE0o b\xEAn \u0111\xF3, t\xF4i ngh\u0129 anh n\xEAn
        qua xem th\u1EED coi c\xF3 h\u1ED7 tr\u1EE3 \u0111\u01B0\u1EE3c kh\xF4ng. "
      objectReference: {fileID: 0}
    - target: {fileID: 259310711090731086, guid: 9aff9630e4c2fab4a92a08387a6d9d9e, type: 3}
      propertyPath: 'content.Array.data[6]'
      value: "\u0110\u01B0\u1EE3c r\u1ED3i, t\xF4i s\u1EBD \u0111\u1EBFn khu \u0111\xE1nh
        c\xE1 xem th\u1EED. "
      objectReference: {fileID: 0}
