  playerNpc: {fileID: 7368070188821449972}
  player: {fileID: 0}
  cam: {fileID: 3814312925763104713}
  camcine: {fileID: 2612956237429143360}
  names:
  - "H\xE0 Nh\xE2n"
  - "Th\u01B0\u01A1ng nh\xE2n"
  - "Th\u01B0\u01A1ng nh\xE2n"
  - "Th\u01B0\u01A1ng nh\xE2n"
  - "H\xE0 nh\xE2n"
  - "Th\u01B0\u01A1ng Nh\xE2n"
  - "Th\u01B0\u01A1ng Nh\xE2n"
  - "Th\u01B0\u01A1ng Nh\xE2n"
  - "H\xE0 Nh\xE2n"
  content:
  - "Anh kh\xF4ng sao ch\u1EE9 ?"
  - "\xC0 v\xE2ng, c\u1EA3m \u01A1n anh. T\xF4i t\u01B0\u1EDFng s\u1EBD ph\u1EA3i
    b\u1ECF m\u1EA1ng \u1EDF \u0111\xE2y ch\u1EE9 "
  - "B\u1ECDn ch\xFAng \u0111ang c\u1ED1 l\u1EA5y c\u1EAFp nh\u1EEFng m\xF3n \u0111\u1ED3
    trong t\xFAi c\u1EE7a t\xF4i "
  - "Th\u1EADt l\xE0 nguy hi\u1EC3m."
  - "Anh l\xE0 m\u1ED9t th\u01B0\u01A1ng nh\xE2n \u01B0? "
  - "V\xE2ng, t\xF4i l\xE0 m\u1ED9t th\u01B0\u01A1ng nh\xE2n "
  - "T\xF4i \u0111i lang thang kh\u1EAFp m\u1ECDi n\u01A1i v\xE0 mang \u0111\u1EBFn
    r\u1EA5t nhi\u1EC1u m\xF3n \u0111\u1ED3 r\u1EA5t h\u1EEFu d\u1EE5ng"
  - "Anh c\xF3 mu\u1ED1n xem qua kh\xF4ng ?"
  - "\xC0 \u0111\u01B0\u1EE3c, h\xE3y cho t\xF4i xem anh c\xF3 g\xEC. "
  buttonF: {fileID: 597259923}
  isContent: 0
  isButtonF: 0
  buttonSkip: {fileID: 1777979913}
