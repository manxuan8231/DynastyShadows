    - target: {fileID: 8245234115772313924, guid: 81a9d3d810c663748be0f2d8ad126ed0, type: 3}
      propertyPath: m_text
      value: "Th\xEC\u2026 gi\xE0 r\u1ED3i, \u0111\xE2u lanh l\u1EB9 nh\u01B0 con
        \u0111\u01B0\u1EE3c n\u1EEFa. B\xE1c kh\xF4ng mu\u1ED1n r\u1EE7 ai trong
        l\xE0ng, t\u1EE5i n\xF3 th\u1EA5y b\xE1c y\u1EBFu l\u1EA1i x\u1EA7m x\xEC.\r\nN\u1EBFu
        ti\u1EC7n, con gi\xFAp b\xE1c \u0111u\u1ED5i ch\xFAng \u0111i \u0111\u01B0\u1EE3c
        kh\xF4ng? Coi nh\u01B0\u2026 t\u1EADp tay tr\u01B0\u1EDBc khi ra ngo\xE0i
        l\xE0m chuy\u1EC7n l\u1EDBn.\r\n"
      objectReference: {fileID: 0}
